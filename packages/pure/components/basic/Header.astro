---
import config from 'virtual:config'

import { Icon } from '../user'

const navIconByPath = {
  '/blog': 'document',
  '/projects': 'package',
  '/links': 'link',
  '/about': 'info'
} as const

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/'
const isActivePath = (link: string) => {
  const normalizedLink = link.replace(/\/+$/, '') || '/'
  return normalizedLink === '/'
    ? currentPath === '/'
    : currentPath === normalizedLink || currentPath.startsWith(`${normalizedLink}/`)
}
---

<header-component
  class='group sticky top-4 z-50 max-md:z-30 mb-12 flex items-center justify-between rounded-xl border border-transparent max-sm:py-1 sm:rounded-2xl'
>
  <a
    class='z-30 text-xl font-semibold group-[.not-top]:ms-2 sm:group-[.not-top]:ms-3'
    style='transition:margin-inline 0.3s'
    href='/'
    aria-label='Brand'>{config.title}</a
  >

  <div class='header-shell flex items-center gap-x-2'>
    {/* Menu links */}
    <div
      id='headerExpandContent'
      class='end-0 start-0 top-12 grid border border-transparent sm:grid-rows-1'
    >
      <div
        class='mobile-nav-list flex flex-col items-center justify-center overflow-hidden sm:flex-row'
      >
        {
          config.header.menu.map((item) => {
            const active = isActivePath(item.link)
            const icon =
              navIconByPath[item.link as keyof typeof navIconByPath] ?? navIconByPath['/blog']

            return (
              <a
                href={item.link}
                class='mobile-nav-item w-full flex-none grow py-2 font-medium transition-colors sm:w-fit sm:px-3'
                data-active={active ? 'true' : undefined}
                aria-current={active ? 'page' : undefined}
              >
                <Icon name={icon} class='mobile-nav-icon size-5 sm:hidden' />
                <span>{item.title}</span>
              </a>
            )
          })
        }
        <div class='mobile-search-wrap flex w-full grow flex-row sm:w-fit sm:gap-x-5'>
          <a
            class='mobile-search px-1 py-2 transition-colors sm:px-2'
            data-active={isActivePath('/search') ? 'true' : undefined}
            aria-current={isActivePath('/search') ? 'page' : undefined}
            aria-label='搜索'
            href='/search'
            title='搜索'
          >
            <Icon name='search' class='size-5' />
            <span class='mobile-search-label sm:hidden'>搜索</span>
          </a>
        </div>
      </div>
    </div>

    {/* buttons */}
    <div class='header-actions z-30 flex gap-x-4 group-[.not-top]:gap-x-2' style='transition:gap 0.3s'>
      <button
        id='toggleMenu'
        class='mobile-menu-toggle rounded-xl border transition-colors hover:bg-border sm:hidden'
        type='button'
        aria-controls='headerExpandContent'
        aria-expanded='false'
      >
        <span class='sr-only'>打开导航菜单</span>
        <Icon class='size-5' name='menu' />
      </button>

      <!-- From Uiverse.io by RiccardoRapelli -->
      <label class='theme-switch'>
        <input id='themeToggleCheckbox' class='theme-switch__checkbox' type='checkbox' aria-label='切换亮暗主题' />
        <div class='slider round'>
          <div class='sun-moon'>
            <svg id='moon-dot-1' class='moon-dot' viewBox='0 0 100 100'><circle cx='50' cy='50' r='50'></circle></svg>
            <svg id='moon-dot-2' class='moon-dot' viewBox='0 0 100 100'><circle cx='50' cy='50' r='50'></circle></svg>
            <svg id='moon-dot-3' class='moon-dot' viewBox='0 0 100 100'><circle cx='50' cy='50' r='50'></circle></svg>
            <svg id='light-ray-1' class='light-ray' viewBox='0 0 100 100'><circle cx='50' cy='50' r='50'></circle></svg>
            <svg id='light-ray-2' class='light-ray' viewBox='0 0 100 100'><circle cx='50' cy='50' r='50'></circle></svg>
            <svg id='light-ray-3' class='light-ray' viewBox='0 0 100 100'><circle cx='50' cy='50' r='50'></circle></svg>
            <svg id='cloud-1' class='cloud-dark' viewBox='0 0 100 100'><circle cx='50' cy='50' r='50'></circle></svg>
            <svg id='cloud-2' class='cloud-dark' viewBox='0 0 100 100'><circle cx='50' cy='50' r='50'></circle></svg>
            <svg id='cloud-3' class='cloud-dark' viewBox='0 0 100 100'><circle cx='50' cy='50' r='50'></circle></svg>
            <svg id='cloud-4' class='cloud-light' viewBox='0 0 100 100'><circle cx='50' cy='50' r='50'></circle></svg>
            <svg id='cloud-5' class='cloud-light' viewBox='0 0 100 100'><circle cx='50' cy='50' r='50'></circle></svg>
            <svg id='cloud-6' class='cloud-light' viewBox='0 0 100 100'><circle cx='50' cy='50' r='50'></circle></svg>
          </div>
          <div class='stars'>
            <svg id='star-1' class='star' viewBox='0 0 20 20'><path d='M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z'></path></svg>
            <svg id='star-2' class='star' viewBox='0 0 20 20'><path d='M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z'></path></svg>
            <svg id='star-3' class='star' viewBox='0 0 20 20'><path d='M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z'></path></svg>
            <svg id='star-4' class='star' viewBox='0 0 20 20'><path d='M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z'></path></svg>
          </div>
        </div>
      </label>
    </div>
  </div>
</header-component>

{/* Use inline to sync checkbox state before paint */}
<script is:inline>
  ;(() => {
    const themeCheckbox = document.getElementById('themeToggleCheckbox')
    let theme = localStorage.getItem('theme')
    if (theme !== 'dark' && theme !== 'light') {
      theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
    }
    if (themeCheckbox) themeCheckbox.checked = theme === 'dark'
  })()
</script>
<script>
  import { setTheme, showToast } from '../../utils'

  class Header extends HTMLElement {
    constructor() {
      super()
    }

    connectedCallback() {
      // Header
      let preScrollY = window.scrollY
      this.classList.toggle('not-top', preScrollY > 20)
      window.addEventListener('scroll', () => {
        this.classList.toggle('not-top', window.scrollY > 20)
        this.dataset.show = (window.scrollY < 350 || window.scrollY < preScrollY).toString()
        preScrollY = window.scrollY
      })

      // Dark Mode
      const themeCheckbox = this.querySelector('#themeToggleCheckbox') as HTMLInputElement

      themeCheckbox.addEventListener('change', () => {
        const newTheme = themeCheckbox.checked ? 'dark' : 'light'
        setTheme(newTheme, true)
        showToast({ message: `Set theme to ${newTheme}` })
      })

      // Menu
      const menuButton = this.querySelector<HTMLButtonElement>('#toggleMenu')
      const menuContent = this.querySelector<HTMLElement>('#headerExpandContent')
      const mobileMedia = window.matchMedia('(max-width: 639px)')
      const setMenuExpanded = (expanded: boolean) => {
        this.classList.toggle('expanded', expanded)
        menuButton?.setAttribute('aria-expanded', expanded.toString())
        const hiddenOnMobile = mobileMedia.matches && !expanded
        menuContent?.toggleAttribute('inert', hiddenOnMobile)
        if (mobileMedia.matches) menuContent?.setAttribute('aria-hidden', hiddenOnMobile.toString())
        else menuContent?.removeAttribute('aria-hidden')
      }

      setMenuExpanded(false)
      menuButton?.addEventListener('click', () => {
        setMenuExpanded(!this.classList.contains('expanded'))
      })
      menuContent?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenuExpanded(false))
      })
      this.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && this.classList.contains('expanded')) {
          setMenuExpanded(false)
          menuButton?.focus()
        }
      })
      mobileMedia.addEventListener('change', () => {
        setMenuExpanded(this.classList.contains('expanded'))
      })
    }
  }

  customElements.define('header-component', Header)
</script>

<style>
  header-component {
    transition:
      padding 0.3s,
      transform 0.3s,
      margin-inline 0.3s,
      border 0.15s,
      background-color 0.15s,
      backdrop-filter 0.2s;

    &.not-top {
      --un-border-opacity: 1;
      border-color: hsl(var(--border) / 0.72);
      --un-bg-opacity: 1;
      background-color: hsl(var(--background) / 0.68);
      -webkit-backdrop-filter: saturate(165%) blur(18px);
      backdrop-filter: saturate(165%) blur(18px);
      padding-left: 0.375rem;
      padding-right: 0.375rem;
      box-shadow:
        rgb(255, 255, 255) 0px 0px 0px 0px,
        rgba(24, 24, 27, 0.06) 0px 0px 0px 1px,
        rgba(15, 23, 42, 0.14) 0px 14px 28px -16px,
        rgba(15, 23, 42, 0.08) 0px 8px 10px -8px;
    }
    &[data-show='false']:not(.expanded) {
      transform: translateY(-5rem);
    }
  }
  @media (min-width: 800px) {
    header-component.not-top {
      margin-inline: 8%;
    }
  }
  :global(.dark) header-component.not-top {
    border-color: hsl(var(--border) / 0.58);
    background-color: hsl(var(--background) / 0.62);
    -webkit-backdrop-filter: saturate(145%) blur(14px);
    backdrop-filter: saturate(145%) blur(14px);
    box-shadow:
      rgb(255, 255, 255) 0px 0px 0px 0px,
      rgba(148, 163, 184, 0.14) 0px 0px 0px 1px,
      rgba(2, 8, 23, 0.56) 0px 16px 36px -18px,
      rgba(15, 23, 42, 0.4) 0px 8px 14px -10px;
  }

  /* header menu */
  @media (max-width: 639px) {
    header-component {
      min-height: 3.5rem;
      padding: 0.375rem;
      border-color: hsl(var(--border) / 0.72);
      background-color: hsl(var(--background) / 0.88);
      -webkit-backdrop-filter: saturate(145%) blur(12px);
      backdrop-filter: saturate(145%) blur(12px);
    }

    header-component > a {
      display: none;
    }

    .header-shell,
    .header-actions {
      width: 100%;
    }

    header-component.not-top {
      padding: 0.375rem;
      box-shadow: 0 4px 8px -7px hsl(var(--foreground) / 0.42);
    }

    :global(.dark) header-component,
    :global(.dark) header-component.not-top {
      border-color: hsl(var(--border) / 0.7);
      background-color: hsl(var(--background) / 0.84);
      box-shadow: 0 4px 8px -7px hsl(0 0% 0% / 0.7);
    }

    .header-actions {
      align-items: center;
      justify-content: space-between;
      gap: 0;
    }

    .mobile-menu-toggle {
      display: grid;
      width: 2.75rem;
      height: 2.75rem;
      flex: none;
      place-items: center;
      padding: 0;
      color: hsl(var(--foreground));
      border-color: hsl(var(--border));
      background-color: hsl(var(--background) / 0.72);
    }

    .mobile-menu-toggle:hover {
      color: hsl(var(--foreground));
      background-color: hsl(var(--accent));
    }

    .mobile-menu-toggle:focus-visible,
    .mobile-nav-item:focus-visible,
    .mobile-search:focus-visible {
      outline: 2px solid hsl(var(--ring));
      outline-offset: 2px;
    }

    #headerExpandContent {
      position: absolute;
      top: calc(100% + 0.5rem);
      inset-inline: 0;
      grid-template-rows: 0fr;
      padding: 0;
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
      transform: translateY(-0.375rem);
      transform-origin: top;
      overflow: hidden;
      border-radius: 1rem;
      border-color: transparent;
      background-color: hsl(var(--background));
      -webkit-backdrop-filter: saturate(145%) blur(12px);
      backdrop-filter: saturate(145%) blur(12px);
      transition:
        grid-template-rows 0.22s ease,
        padding 0.22s ease,
        border-color 0.16s ease,
        opacity 0.16s ease,
        transform 0.22s ease,
        visibility 0s linear 0.22s;
    }

    .expanded #headerExpandContent {
      grid-template-rows: 1fr;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
      padding: 0.75rem;
      border-color: hsl(var(--border));
      box-shadow: 0 6px 8px -8px hsl(var(--foreground) / 0.48);
      transition-delay: 0s;
    }

    :global(.dark) #headerExpandContent {
      background-color: hsl(var(--background));
    }

    .mobile-nav-list {
      align-items: stretch;
      gap: 0.125rem;
    }

    .mobile-nav-item {
      display: flex;
      min-height: 3rem;
      align-items: center;
      gap: 0.75rem;
      padding: 0.625rem 0.75rem;
      border-radius: 0.75rem;
      color: hsl(var(--foreground));
      text-align: left;
    }

    .mobile-nav-item:hover,
    .mobile-nav-item:focus-visible {
      background-color: hsl(var(--accent));
    }

    .mobile-nav-item[data-active='true'] {
      color: hsl(var(--primary));
      background-color: hsl(var(--primary) / 0.11);
    }

    :global(.dark) .mobile-nav-item[data-active='true'] {
      background-color: hsl(var(--primary) / 0.18);
    }

    .mobile-nav-icon {
      flex: none;
    }

    .mobile-search-wrap {
      margin-top: 0.5rem;
      padding-top: 0.75rem;
      border-top: 1px solid hsl(var(--border));
    }

    .mobile-search {
      display: flex;
      width: 100%;
      min-height: 3rem;
      align-items: center;
      gap: 0.75rem;
      padding: 0.625rem 0.75rem;
      border: 1px solid hsl(var(--border));
      border-radius: 0.75rem;
      color: hsl(var(--muted-foreground));
      text-align: left;
    }

    .mobile-search:hover,
    .mobile-search:focus-visible {
      color: hsl(var(--foreground));
      background-color: hsl(var(--accent));
    }

    .mobile-search[data-active='true'] {
      color: hsl(var(--primary));
      border-color: hsl(var(--primary) / 0.42);
      background-color: hsl(var(--primary) / 0.08);
    }
  }

  /* animated theme switch - From Uiverse.io by RiccardoRapelli */
  .theme-switch {
    --toggle-size: 7px;
    position: relative;
    display: inline-block;
    width: 6em;
    height: 3.4em;
  }

  .theme-switch,
  .theme-switch :global(*) {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-size: var(--toggle-size);
  }

  .theme-switch__checkbox {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .theme-switch :global(.slider) {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: #2196f3;
    transition: 0.4s;
    z-index: 0;
    overflow: hidden;
  }

  .theme-switch :global(.sun-moon) {
    position: absolute;
    content: '';
    height: 2.6em;
    width: 2.6em;
    left: 0.4em;
    bottom: 0.4em;
    background-color: yellow;
    transition: 0.4s;
  }

  .theme-switch__checkbox:checked + :global(.slider) {
    background-color: black;
  }

  .theme-switch__checkbox:focus + :global(.slider) {
    box-shadow: 0 0 1px #2196f3;
  }

  .theme-switch__checkbox:checked + :global(.slider) :global(.sun-moon) {
    transform: translateX(2.6em);
    background-color: white;
    animation: rotate-center 0.6s ease-in-out both;
  }

  .theme-switch :global(.moon-dot) {
    opacity: 0;
    transition: 0.4s;
    fill: gray;
  }

  .theme-switch__checkbox:checked + :global(.slider) :global(.sun-moon) :global(.moon-dot) {
    opacity: 1;
  }

  .theme-switch :global(.slider.round) {
    border-radius: 3.4em;
  }

  .theme-switch :global(.slider.round) :global(.sun-moon) {
    border-radius: 50%;
  }

  /* moon dots */
  .theme-switch :global(#moon-dot-1) {
    left: 1em;
    top: 0.3em;
    position: absolute;
    width: 0.6em;
    height: 0.6em;
    z-index: 4;
  }

  .theme-switch :global(#moon-dot-2) {
    left: 0.2em;
    top: 1em;
    position: absolute;
    width: 1em;
    height: 1em;
    z-index: 4;
  }

  .theme-switch :global(#moon-dot-3) {
    left: 1.6em;
    top: 1.8em;
    position: absolute;
    width: 0.3em;
    height: 0.3em;
    z-index: 4;
  }

  /* light rays */
  .theme-switch :global(#light-ray-1) {
    left: -0.8em;
    top: -0.8em;
    position: absolute;
    width: 4.3em;
    height: 4.3em;
    z-index: -1;
    fill: white;
    opacity: 0.1;
  }

  .theme-switch :global(#light-ray-2) {
    left: -50%;
    top: -50%;
    position: absolute;
    width: 5.5em;
    height: 5.5em;
    z-index: -1;
    fill: white;
    opacity: 0.1;
  }

  .theme-switch :global(#light-ray-3) {
    left: -1.8em;
    top: -1.8em;
    position: absolute;
    width: 6em;
    height: 6em;
    z-index: -1;
    fill: white;
    opacity: 0.1;
  }

  /* clouds */
  .theme-switch :global(.cloud-light) {
    position: absolute;
    fill: #eee;
    animation-name: cloud-move;
    animation-duration: 6s;
    animation-iteration-count: infinite;
  }

  .theme-switch :global(.cloud-dark) {
    position: absolute;
    fill: #ccc;
    animation-name: cloud-move;
    animation-duration: 6s;
    animation-iteration-count: infinite;
    animation-delay: 1s;
  }

  .theme-switch :global(#cloud-1) {
    left: 3em;
    top: 1.5em;
    width: 4em;
  }

  .theme-switch :global(#cloud-2) {
    left: 4.4em;
    top: 1em;
    width: 2em;
  }

  .theme-switch :global(#cloud-3) {
    left: 1.8em;
    top: 2.4em;
    width: 3em;
  }

  .theme-switch :global(#cloud-4) {
    left: 3.6em;
    top: 1.8em;
    width: 4em;
  }

  .theme-switch :global(#cloud-5) {
    left: 4.8em;
    top: 1.4em;
    width: 2em;
  }

  .theme-switch :global(#cloud-6) {
    left: 2.2em;
    top: 2.6em;
    width: 3em;
  }

  @keyframes cloud-move {
    0% {
      transform: translateX(0);
    }
    40% {
      transform: translateX(0.4em);
    }
    80% {
      transform: translateX(-0.4em);
    }
    100% {
      transform: translateX(0);
    }
  }

  /* stars */
  .theme-switch :global(.stars) {
    transform: translateY(-3.2em);
    opacity: 0;
    transition: 0.4s;
  }

  .theme-switch :global(.star) {
    fill: white;
    position: absolute;
    transition: 0.4s;
    animation-name: star-twinkle;
    animation-duration: 2s;
    animation-iteration-count: infinite;
  }

  .theme-switch__checkbox:checked + :global(.slider) :global(.stars) {
    transform: translateY(0);
    opacity: 1;
  }

  .theme-switch :global(#star-1) {
    width: 2em;
    top: 0.2em;
    left: 0.3em;
    animation-delay: 0.3s;
  }

  .theme-switch :global(#star-2) {
    width: 0.6em;
    top: 1.6em;
    left: 0.3em;
  }

  .theme-switch :global(#star-3) {
    width: 1.2em;
    top: 2em;
    left: 1em;
    animation-delay: 0.6s;
  }

  .theme-switch :global(#star-4) {
    width: 1.8em;
    top: 0;
    left: 1.8em;
    animation-delay: 1.3s;
  }

  @keyframes star-twinkle {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.2);
    }
    80% {
      transform: scale(0.8);
    }
    100% {
      transform: scale(1);
    }
  }

  @keyframes rotate-center {
    0% {
      transform: translateX(2.6em) rotate(0);
    }
    100% {
      transform: translateX(2.6em) rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    header-component,
    #headerExpandContent,
    .mobile-menu-toggle,
    .theme-switch,
    .theme-switch :global(*) {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
