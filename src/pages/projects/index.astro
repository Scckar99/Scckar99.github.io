---
import { Image } from 'astro:assets'

import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import Sponsors from '@/components/projects/Sponsors.astro'
import Sponsorship from '@/components/projects/Sponsorship.astro'
import alipay from '@/assets/alipay-qrcode.png'
import wechat from '@/assets/wechat-qrcode.png'

const headings = [
  { depth: 2, slug: 'theme', text: "Blog's theme" },
  { depth: 2, slug: 'programs', text: 'Programs' },
  { depth: 2, slug: 'private', text: 'Private Projects' },
  { depth: 2, slug: 'others', text: 'Others' },
  { depth: 2, slug: 'sponsorship', text: 'Sponsorship' }
]
---

<PageLayout title='Projects' {headings} view>
  <p>Github Activities:</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/659eb9/Scckar99'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>
  <p>
    如果你对我的项目感兴趣，你可以自行从GitHub下载项目源码，亲自部署、运行，沉浸式体验它的各项功能与特性。
  </p>

  <h2 id='theme'>Blog's theme</h2>
  <ProjectSection
    projects={[
      {
        name: "🪪 Scckar's Blog",
        description: '基于 Astro 的个人技术博客，记录企业 AI、智能体与软件开发实践。',
        links: [{ type: 'github', href: 'https://github.com/Scckar99/Scckar99.github.io' }]
      }
    ]}
  />

  <h2 id='programs'>Programs</h2>
  <ProjectSection
    projects={[
      {
        name: '🖼️ ImageFlowKit',
        description: '图片批量处理工具集，支持方向矫正、白边裁剪与内容分割提取。',
        links: [
          { type: 'github', href: 'https://github.com/Scckar99/ImageFlowKit' },
          {
            type: 'doc',
            href: 'https://github.com/Scckar99/ImageFlowKit/blob/main/README.md'
          }
        ]
      },
      {
        name: '📝 word2md (Fork)',
        description:
          'Word 转 Markdown 桌面工具，支持图片、公式、表格、批量转换与 Windows 独立运行。',
        links: [
          { type: 'github', href: 'https://github.com/Scckar99/word2md' },
          {
            type: 'doc',
            href: 'https://github.com/Scckar99/word2md/blob/main/README.md'
          }
        ]
      },
      {
        name: '🧾 foreign-invoice-eval',
        description: '本地优先的多模态票据评测台，支持分类、字段提取、汇率换算与人工标注评测。',
        links: [
          { type: 'github', href: 'https://github.com/Scckar99/foreign-invoice-eval' },
          {
            type: 'doc',
            href: 'https://github.com/Scckar99/foreign-invoice-eval/blob/main/README.md'
          }
        ]
      }
    ]}
  />

  <h2 id='private'>Private Projects</h2>
  <p>以下为私有仓库，仅展示项目说明，不提供公开访问链接。</p>
  <ProjectSection
    projects={[
      {
        name: '🔒 visitor-reception-agent',
        description: '钉钉 AI 行政助手，联动 OMS、会议室、用车与接待物料完成来访接待流程。',
        links: []
      },
      {
        name: '🔒 neixiao-shaidan-ai-agent',
        description:
          '基于 Qwen 视觉模型的内销晒单审核智能体，识别销售凭证与转账截图并输出审核结果。',
        links: []
      },
      {
        name: '🔒 ai-assistant-agent',
        description: '钉钉企业 AI 助理，覆盖出差、休假、发票票夹与费用报销等业务流程。',
        links: []
      },
      {
        name: '🔒 loglens',
        description: '本地运行的日志解析与可视化工具，支持格式识别、筛选统计与请求链路追踪。',
        links: []
      },
      {
        name: '🔒 scckar-waline',
        description: '个人博客使用的 Waline 评论服务。',
        links: []
      },
      {
        name: '🔒 rubber-plate-crop',
        description: 'PDF 胶板图智能裁剪服务，支持多目标识别、图片压缩与下游接口推送。',
        links: []
      },
      {
        name: '🔒 daily-ai-news-bot',
        description:
          '基于 LangGraph、Qwen 与钉钉的 AI 日报机器人，支持资讯采集、摘要筛选、定时调度与定向推送。',
        links: []
      },
      {
        name: '🔒 hr-assistant-agent',
        description: '钉钉人事助理机器人，支持离职登记、重点群体查询、权限校验与 HR 系统集成。',
        links: []
      },
      {
        name: '🔒 tape-reader-private',
        description: '基于视觉大模型的胶板读数工具，支持图片测量、批量评测与 HTTP 接口调用。',
        links: []
      },
      {
        name: '🔒 source-agent',
        description: '钉钉寻源智能体 Demo，结合全网搜索、地图与企业信息查询生成供应商推荐。',
        links: []
      }
    ]}
  />
  <h2 id='others'>Others</h2>
  <ProjectSection
    projects={[
      {
        name: 'Scckar',
        description: '企业 AI 应用、智能体与多模态业务系统实践。',
        links: [{ type: 'github', href: 'https://github.com/Scckar99' }]
      }
    ]}
  />

  <!-- sponsorship -->
  <h2 id='sponsorship'>Sponsorship</h2>
  <p>❤️感谢给予项目支持的赞助伙伴，不管你有任何想法，欢迎留言或者联系我！</p>
  <Sponsorship
    methods={[
      { name: 'WeChat', icon: 'wechat-pay', image: wechat },
      { name: 'Alipay', icon: 'alipay', image: alipay }
    ]}
  />
  <p>❤️感谢以下赞助伙伴的投喂:</p>
  <Sponsors sponsors={[{ name: 'waby', amount: '10.00', date: '2025-10-10' }]} />
</PageLayout>

<style>
  .sponsorship-card {
    & .sponsorship-card-img {
      opacity: 0.3;
      --un-blur: blur(4px);
      filter: var(--un-blur);
    }

    &:hover {
      & .sponsorship-card-icon {
        opacity: 0;
      }
      & .sponsorship-card-img {
        opacity: 1;
        --un-blur: blur(0);
      }
    }
  }
</style>
