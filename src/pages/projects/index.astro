---
import { Image } from 'astro:assets'

import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'
import Sponsors from '@/components/projects/Sponsors.astro'
import Sponsorship from '@/components/projects/Sponsorship.astro'
import alipay from '@/assets/alipay-qrcode.jpg'
import wechat from '@/assets/wechat-qrcode.jpg'

const headings = [
  { depth: 2, slug: 'theme', text: "Blog's theme" },
  { depth: 2, slug: 'programs', text: 'Programs' },
  { depth: 2, slug: 'others', text: 'Others' },
  { depth: 2, slug: 'sponsorship', text: 'Sponsorship' }
]
---

<PageLayout title='Projects' {headings} view>
  <p>Github Activities:</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/659eb9/Scckar99'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>
  <p>
    如果你对我的项目感兴趣，你可以自行从GitHub下载项目源码，亲自部署、运行，沉浸式体验它的各项功能与特性。
  </p>

  <h2 id='theme'>Blog's theme</h2>
  <ProjectSection
    projects={[
      {
        name: "🪪 Scckar's Blog",
        description: '基于 Astro 构建并持续改造的个人博客网站',
        links: [{ type: 'github', href: 'https://github.com/Scckar99/Scckar99.github.io' }]
      }
    ]}
  />

  <h2 id='programs'>Programs</h2>
  <ProjectSection
    projects={[
      {
        name: '🖼️ ImageFlowKit',
        description: '一套完整的图片批量处理工具，包含方向矫正、白边裁剪、内容提取等功能。',
        links: [
          { type: 'github', href: 'https://github.com/Scckar99/ImageFlowKit' },
          {
            type: 'doc',
            href: 'https://github.com/Scckar99/ImageFlowKit/blob/main/README.md'
          }
        ]
      },
      {
        name: '📝 word2md',
        description: 'Word 文档转 Markdown 工具，便于文档整理与内容迁移。',
        links: [
          { type: 'github', href: 'https://github.com/Scckar99/word2md' },
          {
            type: 'doc',
            href: 'https://github.com/Scckar99/word2md/blob/main/README.md'
          }
        ]
      }
    ]}
  />
  <h2 id='others'>Others</h2>
  <ProjectSection
    projects={[
      {
        name: 'Scckar',
        description: "Scckar's Github",
        links: [{ type: 'github', href: 'https://github.com/Scckar99' }]
      }
    ]}
  />

  <!-- sponsorship -->
  <h2 id='sponsorship'>Sponsorship</h2>
  <p>❤️感谢给予项目支持的赞助伙伴，不管你有任何想法，欢迎留言或者联系我！</p>
  <Sponsorship
    methods={[
      { name: 'WeChat', icon: 'wechat-pay', image: wechat },
      { name: 'Alipay', icon: 'alipay', image: alipay }
    ]}
  />
  <p>❤️感谢以下赞助伙伴的投喂:</p>
  <Sponsors sponsors={[{ name: 'waby', amount: '10.00', date: '2025-10-10' }]} />
</PageLayout>

<style>
  .sponsorship-card {
    & .sponsorship-card-img {
      opacity: 0.3;
      --un-blur: blur(4px);
      filter: var(--un-blur);
    }

    &:hover {
      & .sponsorship-card-icon {
        opacity: 0;
      }
      & .sponsorship-card-img {
        opacity: 1;
        --un-blur: blur(0);
      }
    }
  }
</style>
