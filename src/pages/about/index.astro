---
import { Collapse, Spoiler } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import Substats from '@/components/about/Substats.astro'
import ToolSection from '@/components/about/ToolSection.astro'

const headings = [
  { depth: 2, slug: 'hobbies', text: 'Hobbies' },
  { depth: 2, slug: 'tools', text: 'Tools' },
  { depth: 2, slug: 'social-networks', text: 'Social Networks' },
  { depth: 2, slug: 'gossips', text: 'Gossips' }
]
---

<PageLayout title='About' {headings} comment>
  <p>Developer / Designer</p>
  <p>
    专注于人工智能技术研发，致力于将 AI 技术应用于实际业务场景。<br />
    擅长机器学习、深度学习、自然语言处理等前沿技术，具备AI模型开发与部署经验。<br />
    熟悉智能体(Agent)系统设计、工作流自动化、知识库构建、RPA机器人流程自动化、RAG检索增强生成等企业级AI解决方案。<br
    />
    热爱探索新技术，关注AI领域的最新发展动态，致力于推动AI技术的创新应用。
  </p>
  <p>
    My motto: Be bold in innovation, always push boundaries. <Spoiler>想养一只可爱的小暹罗</Spoiler>
  </p>

  {/* general-talk */}
  <h2 id='hobbies'>Hobbies</h2>
  <ul>
    <li>
      第九艺术：🎮网游&🕹️单机，偏好肉鸽（如《土豆兄弟》《吸血鬼幸存者》）、视觉推理（如《人狼村之谜》《疑案追声》）和MOBA/FPS（如《英雄联盟》《无畏契约》），热爱策略与叙事并重的游戏体验.
    </li>
    <li>🏊‍♀️游泳&💪健身，目前正在通过科学饮食+力量训练训练努力增重增肌.</li>
    <li>📷拍照&📹摄影，目前使用 Nikon-Z30 记录生活与光影，在构图和后期上持续精进，努力提升技术.</li>
    <li>
      📺悬疑&🎬智斗，沉迷于剧情的层层反转与人物间的心理博弈，喜欢在推理与逻辑的缝隙中寻找真相.
    </li>
  </ul>

  {/* tools */}
  <h2 id='tools'>Tools</h2>
  <p>当前使用的一些工具:</p>
  <ToolSection
    class='mb-5'
    title='AI & Agents'
    tools={[
      {
        name: 'Codex',
        description: 'AI Coding Agent',
        href: 'https://openai.com/codex/',
        icon: import('@/assets/tools/chatgpt.svg?raw')
      },
      {
        name: 'Claude Code',
        description: 'AI Coding Agent',
        href: 'https://www.anthropic.com/claude-code',
        icon: import('@/assets/tools/claude.svg?raw')
      },
      {
        name: 'ChatGPT',
        description: 'AI Assistant',
        href: 'https://chatgpt.com/',
        icon: import('@/assets/tools/chatgpt.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Development'
    tools={[
      {
        name: 'VS Code',
        description: 'Code Editor',
        href: 'https://code.visualstudio.com/',
        icon: import('@/assets/tools/vscode.svg?raw')
      },
      {
        name: 'GitHub',
        description: 'Code Hosting & Collaboration',
        href: 'https://github.com/',
        icon: import('@/assets/tools/github.svg?raw')
      },
      {
        name: 'Python',
        description: 'Programming Language',
        href: 'https://www.python.org/',
        icon: import('@/assets/tools/python.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Knowledge & Collaboration'
    tools={[
      {
        name: 'Obsidian',
        description: 'Knowledge Base',
        href: 'https://obsidian.md/',
        icon: import('@/assets/tools/obsidian.svg?raw')
      },
      {
        name: 'DingTalk',
        description: 'Team Collaboration',
        href: 'https://www.dingtalk.com/',
        icon: import('@/assets/tools/dingtalk.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Browser & Terminal'
    tools={[
      {
        name: 'Chrome',
        description: 'Browser',
        href: 'https://www.google.com/chrome/',
        icon: import('@/assets/tools/chrome.svg?raw')
      },
      {
        name: 'iTerm2',
        description: 'Terminal',
        href: 'https://iterm2.com/',
        icon: import('@/assets/tools/iterm2.svg?raw')
      }
    ]}
  />
  <ToolSection
    class='mb-5'
    title='Environment'
    tools={[
      {
        name: 'macOS',
        description: 'Operating System',
        href: 'https://www.apple.com/macos/',
        icon: import('@/assets/tools/apple.svg?raw')
      },
      {
        name: 'Windows 11',
        description: 'Operating System',
        href: 'https://www.microsoft.com/windows/windows-11',
        icon: import('@/assets/tools/windows11.svg?raw')
      }
    ]}
  />

  {/* social-networks */}
  <h2 id='social-networks'>Social Networks</h2>
  <Substats
    stats={[
      {
        platform: 'GitHub',
        icon: 'github',
        link: 'https://github.com/Scckar99',
        text: 'followers',
        api: 'github/Scckar99'
      },
      {
        platform: 'Bilibili',
        icon: 'bilibili',
        color: '#fb7299', // B站粉色
        link: 'https://space.bilibili.com/43722398',
        text: '粉丝',
        api: 'bilibili/43722398'
      },
      {
        platform: 'Steam',
        icon: 'steam',
        color: '#50769d',
        link: 'https://steamcommunity.com/profiles/76561198500937199/',
        text: 'games',
        api: 'steamgames/76561198500937199'
      }
    ]}
  />

  {/* gossips */}
  <h2 id='gossips'>Gossips</h2>
  <Collapse title='想到什么说什么'> 暂无。 </Collapse>
</PageLayout>
