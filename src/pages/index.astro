---
import { Image } from 'astro:assets'

import { Quote } from 'astro-pure/advanced'
import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Card, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import avatar from '@/assets/avatar.png'
import config from '@/site-config'

const languages = ['Python', 'JavaScript', 'TypeScript', 'SQL']
const ai_tech = ['TensorFlow', 'PyTorch', 'LangChain', 'RAG', 'Agent', 'Workflow']
const tools = ['Git', 'Vim', 'RPA', 'Docker', 'Vscode', 'AI IDE']

const MAX_POSTS = 10
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#659EB9'>
  <div class='home-grid-bg' aria-hidden='true'></div>
  <main class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <div class='avatar-glow'>
        <Image
          src={avatar}
          alt='profile'
          class='h-28 w-auto rounded-full border p-1'
          loading='eager'
        />
      </div>

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-3xl font-bold'>{config.author}</h1>
        <div class='flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <Label title='China/ZhongShan'>
            <Icon name='location' class='size-5' slot='icon' />
          </Label>
          <Label
            title='Github'
            as='a'
            href='https://github.com/Scckar99/Scckar99.github.io'
            target='_blank'
          >
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
        </div>
      </div>
    </section>

    <div id='content' class='animate flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <Section title='About'>
        <p class='text-muted-foreground'>Developer / Designer</p>
        <p class='text-muted-foreground'>
          专注于人工智能技术研发，致力于将 AI 技术应用于实际业务场景。<br>
          擅长机器学习、深度学习、自然语言处理等前沿技术，具备AI模型开发与部署经验。<br>
          熟悉智能体(Agent)系统设计、工作流自动化、知识库构建、RPA机器人流程自动化、RAG检索增强生成等企业级AI解决方案。<br>
          热爱探索新技术，关注AI领域的最新发展动态，致力于推动AI技术的创新应用。
        </p>

      <!-- Shields.io徽章 -->
    <div class='flex flex-wrap gap-2 mb-4 dark:opacity-90 dark:contrast-125'>
      <img
        src='https://img.shields.io/badge/Code%20Time-2500%2B%20hours-blue'
        alt='Code Time'
        loading='lazy'
        class='h-5'
      />
      <img
        src='https://img.shields.io/badge/Streak-365%2B%20days-orange'
        alt='Streak'
        loading='lazy'
        class='h-5'
      />
      <img
        src='https://img.shields.io/badge/Languages-10%2B-green'
        alt='Languages'
        loading='lazy'
        class='h-5'
      />
    </div>

        <Button title='More about me' class='w-fit self-end' href='/about' variant='ahead' />
      </Section>
      {
        allPostsByDate.length > 0 && (
          <Section title='Posts'>
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {allPostsByDate.map((p) => (
                <li class='flex flex-col gap-x-2 sm:flex-row'>
                  <PostPreview post={p} />
                </li>
              ))}
            </ul>
            <Button title='More posts' class='w-fit self-end' href='/blog' variant='ahead' />
          </Section>
        )
      }

      <Section title='Education'>
        <Card
          as='a'
          heading='Yunnan University'
          subheading='智能科学与技术 学士学位'
          date='Sept 2021 - July 2025'
          href='https://www.ynu.edu.cn/'
        >
          <img
            class='absolute end-0 z-0 m-0 -my-3 h-full w-1/2 object-cover opacity-40'
            src='/images/云南大学-logo.svg'
            alt='云南大学'
          />
        </Card>
      </Section>

      <Section title='Skills'>
        <SkillLayout title='Languages' skills={languages} />
        <SkillLayout title='AI Tech' skills={ai_tech} />
        <SkillLayout title='Tools' skills={tools} />
      </Section>
    </div>
    <Quote class='mt-12' />
  </main>
</PageLayout>
