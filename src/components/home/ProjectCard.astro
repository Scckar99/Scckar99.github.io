---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import type { HTMLTag, Polymorphic } from 'astro/types'

import { cn } from 'astro-pure/utils'

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
  heading: string
  subheading: string
  imagePath: string
  altText?: string
  href?: string
  class?: string
}

const {
  as: Tag = 'a',
  class: className,
  href,
  heading,
  subheading,
  imagePath,
  altText
} = Astro.props
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/projects/*.{jpeg,jpg,png,gif,avif,webp}'
)
if (!images[imagePath])
  throw new Error(
    `"${imagePath}" does not exist in glob: "src/assets/projects/*.{jpeg,jpg,png,gif,avif,webp}"`
  )
---

<div class={cn(className, 'project-card-shell rounded-2xl p-[1px] transition-all duration-300')}>
  <Tag
    class={cn(
      'project-card group relative flex h-full flex-col gap-y-3 overflow-hidden rounded-[calc(1rem-1px)] border border-border/40 bg-card text-card-foreground transition-all duration-200',
      href && 'hover:border-foreground/25'
    )}
    href={href}
    target={href ? '_blank' : undefined}
  >
    <Image
      src={images[imagePath]()}
      alt={altText ?? heading}
      class='absolute top-0 h-36 w-full object-cover opacity-60 transition-opacity group-hover:opacity-100 dark:opacity-35'
      loading='lazy'
    />
    <div class='project-card-fg z-10 flex flex-col gap-y-0.5 px-5 pb-4 pt-24 transition-all'>
      <h2 class='text-lg font-medium'>{heading}</h2>
      <p class='text-muted-foreground'>{subheading}</p>
    </div>
    <slot />
  </Tag>
</div>

<style>
  .project-card-shell {
    background-image: linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.98) 4%,
      rgba(79, 153, 230, 0.36) 54%,
      rgba(235, 157, 87, 0.3) 100%
    );
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      -8px 14px 34px rgba(0, 113, 227, 0.075),
      8px 16px 36px rgba(207, 118, 44, 0.065);
    transition:
      transform 650ms cubic-bezier(0.32, 0.72, 0, 1),
      box-shadow 650ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .project-card-shell:hover {
    box-shadow:
      inset 0 1px 0 #fff,
      -10px 20px 42px rgba(0, 113, 227, 0.095),
      10px 22px 44px rgba(207, 118, 44, 0.085);
    transform: translateY(-2px);
  }

  .project-card-shell:hover .project-card {
    border-radius: 1rem;
  }

  .project-card {
    border-color: rgba(60, 60, 67, 0.08);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.92);
    transition:
      transform 650ms cubic-bezier(0.32, 0.72, 0, 1),
      border-color 650ms cubic-bezier(0.32, 0.72, 0, 1),
      border-radius 650ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  :global(html.dark) .project-card-shell {
    background-image: linear-gradient(163deg, #00ff75 0%, #3700ff 100%);
    box-shadow: none;
  }

  :global(html.dark) .project-card-shell:hover {
    box-shadow: 0 0 30px 1px rgba(0, 255, 117, 0.3);
    transform: none;
  }

  :global(html.dark) .project-card-shell:hover .project-card {
    transform: scale(0.985);
  }

  :global(html.dark) .project-card {
    border-color: hsl(var(--border) / 0.4);
    box-shadow: none;
  }

  .project-card-fg {
    --un-gradient-shape: to bottom in oklch;
    --un-gradient: var(--un-gradient-shape), var(--un-gradient-stops);
    --un-gradient-from-position: 0%;
    --un-gradient-from: transparent var(--un-gradient-from-position);
    --un-gradient-to-position: 65%;
    --un-gradient-to: hsl(var(--primary-foreground) / var(--un-to-opacity, 1))
      var(--un-gradient-to-position);
    --un-gradient-stops: var(--un-gradient-from), var(--un-gradient-to);
    background-image: linear-gradient(var(--un-gradient));
  }

  .project-card:hover .project-card-fg {
    --un-gradient-to-position: 80%;
  }
</style>
